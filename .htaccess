# ============================================================
# Sunharbor — SEO-friendly URLs
# /forklift-lithium-battery-pack  ->  forklift-lithium-battery-pack.php
# ============================================================
Options -MultiViews -Indexes
RewriteEngine On

# --- Serve sitemap.xml from sitemap.php ---
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# --- 301: /index.php -> directory root ---
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{REQUEST_URI} ^(.*/)index\.php$ [NC]
RewriteRule ^ %1 [R=301,L,NE]

# --- 301: /page.php -> /page (direct client requests only) ---
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{REQUEST_URI} ^(.*/)([^/]+)\.php$ [NC]
RewriteRule ^ %1%2 [R=301,L,NE]

# --- Internally map clean URLs to their .php files ---
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]
